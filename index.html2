<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Advanced Math Analysis Tools</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --panel-bg: #161b22;
            --accent-cyan: #00ecff;
            --accent-gold: #ffd700;
            --text-color: #f0f6fc;
            --border-color: #30363d;
        }

        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color); 
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 90vh;
            touch-action: manipulation; 
            user-select: none; 
            -webkit-user-select: none; 
        }

        /* Responsive Left-Right Grid Layout */
        .game-grid {
            display: flex;
            flex-direction: row;
            gap: 30px;
            max-width: 900px;
            width: 100%;
            background: var(--panel-bg);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        }

        /* Left Side: Clicker & Currencies */
        .left-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-right: 1px solid var(--border-color);
            padding-right: 20px;
        }

        /* Right Side: Scrollable Upgrades & Milestones Box */
        .right-panel {
            flex: 1.2;
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-height: 550px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .currency-box {
            text-align: center;
            margin-bottom: 25px;
        }

        .stat-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #8b949e;
        }

        .stat-value { 
            font-size: 42px; 
            font-weight: 800; 
            margin: 5px 0;
        }
        
        #score {
            color: var(--accent-cyan);
            text-shadow: 0 0 15px rgba(0, 236, 255, 0.3);
        }

        #coins {
            color: var(--accent-gold);
            text-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
            font-size: 32px;
        }

        /* Upgraded Clicker Button placed on the LEFT */
        #click-btn { 
            width: 180px;
            height: 180px;
            border-radius: 50%; 
            font-size: 22px; 
            font-weight: bold;
            cursor: pointer; 
            background: linear-gradient(135deg, #0056b3, var(--accent-cyan)); 
            color: white; 
            border: 4px solid #30363d; 
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
            transition: transform 0.05s ease, box-shadow 0.1s ease;
            -webkit-tap-highlight-color: transparent; 
            outline: none;
        }

        #click-btn:active {
            transform: scale(0.93);
            box-shadow: 0 4px 10px rgba(0, 123, 255, 0.6);
        }

        /* Boxed Section Containers on the Right */
        .section-box {
            background: #1c2128;
            padding: 18px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .section-title {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
            color: #c9d1d9;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 5px;
        }

        .upgrade-btn { 
            width: 100%;
            padding: 12px; 
            font-size: 14px; 
            font-weight: 600;
            cursor: pointer; 
            color: white;
            border: none;
            border-radius: 8px; 
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.2s, opacity 0.2s;
        }

        .standard-tier { background: #238636; }
        .standard-tier:hover:not(:disabled) { background: #2ea043; }
        
        .exclusive-tier { background: #8957e5; }
        .exclusive-tier:hover:not(:disabled) { background: #a371f7; }

        .upgrade-btn:disabled {
            background: #21262d !important;
            color: #8b949e;
            border: 1px solid var(--border-color);
            cursor: not-allowed;
        }

        /* Milestones Styling */
        .milestone-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #22272e;
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 8px;
            font-size: 13px;
            border-left: 4px solid #444;
        }

        .milestone-row.unlocked {
            border-left-color: var(--accent-gold);
            background: rgba(255, 215, 0, 0.05);
        }

        .milestone-reward {
            font-size: 11px;
            color: var(--accent-gold);
            font-weight: bold;
        }

        #resource-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #484f58;
            text-decoration: none;
            font-size: 11px;
        }

        /* Handle Mobile Screens gracefully stacked */
        @media (max-width: 650px) {
            .game-grid { flex-direction: column; }
            .left-panel { border-right: none; border-bottom: 1px solid var(--border-color); padding-right: 0; padding-bottom: 20px; }
            .right-panel { max-height: none; }
        }
    </style>
</head>
<body>

    <div style="display: flex; flex-direction: column; width: 100%; align-items: center;">
        <div class="game-grid">
            
            <!-- LEFT PANEL: Tapping and Stats -->
            <div class="left-panel">
                <div class="currency-box">
                    <div class="stat-label">Data Packets</div>
                    <div class="stat-value" id="score">0</div>
                    
                    <div class="stat-label" style="margin-top: 15px;">Secure Coins</div>
                    <div class="stat-value" id="coins">0</div>
                    <div style="font-size: 11px; color:#8b949e;" id="coin-rate">Progress to Coin: 0/10 clicks</div>
                </div>
                
                <button id="click-btn" onclick="handleClick()">TAP DATA</button>
            </div>
            
            <!-- RIGHT PANEL: Upgrades and Milestones -->
            <div class="right-panel">
                
                <!-- Box 1: Standard Upgrades (Costs Data) -->
                <div class="section-box">
                    <div class="section-title">Standard Infrastructure</div>
                    <button class="upgrade-btn standard-tier" id="up-1" onclick="buyStandard(0, 1, 15)">
                        <span>Buy Local Node (+1 Data/s)</span>
                        <span id="c-1">Cost: 15 Data</span>
                    </button>
                    <button class="upgrade-btn standard-tier" id="up-2" onclick="buyStandard(1, 5, 100)">
                        <span>Upgrade Mainframe (+5 Data/s)</span>
                        <span id="c-2">Cost: 100 Data</span>
                    </button>
                    <button class="upgrade-btn standard-tier" id="up-3" onclick="buyStandard(2, 25, 600)">
                        <span>Deploy Cloud Cluster (+25 Data/s)</span>
                        <span id="c-3">Cost: 600 Data</span>
                    </button>
                </div>

                <!-- Box 2: Exclusive Upgrades (Costs Coins) -->
                <div class="section-box">
                    <div class="section-title">Exclusive Coin Exchange</div>
                    <button class="upgrade-btn exclusive-tier" id="ex-1" onclick="buyExclusive(0, 200)">
                        <span>3X Manual Clicking Power</span>
                        <span id="ec-1">Cost: 200 Coins</span>
                    </button>
                    <button class="upgrade-btn exclusive-tier" id="ex-2" onclick="buyExclusive(1, 500)" disabled>
                        <span>Unlocked at 1,000 Total Clicks</span>
                        <span id="ec-2">Cost: 500 Coins</span>
                    </button>
                </div>

                <!-- Box 3: Milestones & Achievements -->
                <div class="section-box">
                    <div class="section-title">System Milestones</div>
                    <div class="milestone-row" id="m-1">
                        <div>First Taps (10 Total Clicks)</div>
                        <div class="milestone-reward" id="mr-1">+50 Coins</div>
                    </div>
                    <div class="milestone-row" id="m-2">
                        <div>Data Entry (250 Total Clicks)</div>
                        <div class="milestone-reward" id="mr-2">+150 Coins</div>
                    </div>
                    <div class="milestone-row" id="m-3">
                        <div>Network Specialist (1,000 Total Clicks)</div>
                        <div class="milestone-reward" id="mr-3">Unlocks Store Item & +500 Coins</div>
                    </div>
                </div>

            </div>
        </div>

        <a id="resource-link" href="https://discord.gg" target="_blank">Documentation & Study Resources Reference</a>
    </div>

    <script>
        // Game State Variables
        let dataCount = 0;
et totalClicks = 0;
let coinCount = 0;
let clickProgress = 0;
let dataPerSecond = 0;
let clickPower = 1;
// Dynamic Multipliers
let coinsPerCycle = 1; // Gives more coins over time as you hit milestones
// Upgrade Costs & Tracking
let standardCosts =;
let exclusiveOwned = [false, false];
// Milestone Tracking
let milestones = [
{ id: 1, target: 10, reward: 50, claimed: false },
{ id: 2, target: 250, reward: 150, claimed: false },
{ id: 3, target: 1000, reward: 500, claimed: false }
];
function updateDisplay() {
// Update Currencies
document.getElementById('score').textContent = Math.floor(dataCount);
document.getElementById('coins').textContent = coinCount;
document.getElementById('coin-rate').textContent = Progress to Coin: ${clickProgress}/10 clicks;
// Validate Standard Upgrades
for(let i = 0; i < standardCosts.length; i++) {
let btn = document.getElementById('up-' + (i+1));
btn.disabled = (dataCount < standardCosts[i]);
}
// Validate Exclusive Upgrade 1 (3X Click)
let ex1 = document.getElementById('ex-1');
if (exclusiveOwned[0]) {
ex1.disabled = true;
ex1.querySelector('span:first-child').textContent = "Purchased 3X Clicker!";
document.getElementById('ec-1').textContent = "MAX";
} else {
ex1.disabled = (coinCount < 200);
}
// Validate Exclusive Upgrade 2 (Unlocked via Milestone 3)
let ex2 = document.getElementById('ex-2');
if (milestones[2].claimed) {
if (exclusiveOwned[1]) {
ex2.disabled = true;
ex2.querySelector('span:first-child').textContent = "Purchased Quantum Core (+100/s)!";
document.getElementById('ec-2').textContent = "MAX";
} else {
ex2.disabled = (coinCount < 500);
ex2.querySelector('span:first-child').textContent = "Quantum Core (+100 Data/s)";
document.getElementById('ec-2').textContent = "Cost: 500 Coins";
}
}
}
function handleClick() {
dataCount += clickPower;
totalClicks++;
clickProgress++;
// Earn coins for every 10 clicks
if (clickProgress >= 10) {
coinCount += coinsPerCycle;
clickProgress = 0;
}
checkMilestones();
updateDisplay();
}
function buyStandard(index, rateAdd, baseCost) {
if (dataCount >= standardCosts[index]) {
dataCount -= standardCosts[index];
dataPerSecond += rateAdd;
standardCosts[index] = Math.floor(standardCosts[index] * 1.5);
document.getElementById('c-' + (index+1)).textContent = Cost: ${standardCosts[index]} Data;
updateDisplay();
}
}
function buyExclusive(index, cost) {
if (coinCount >= cost && !exclusiveOwned[index]) {
coinCount -= cost;
exclusiveOwned[index] = true;
if (index === 0) {
clickPower *= 3; // Apply 3X Clicker
} else if (index === 1) {dataPerSecond += 100; // Apply massive passive buff
}
updateDisplay();
}
}
function checkMilestones() {
milestones.forEach((m) => {
if (totalClicks >= m.target && !m.claimed) {
m.claimed = true;
coinCount += m.reward;
// Mark visual row as unlocked
let row = document.getElementById('m-' + m.id);
row.classList.add('unlocked');
document.getElementById('mr-' + m.id).textContent = "UNLOCKED";
// Milestone Specific Perks
if (m.id === 1) coinsPerCycle = 2; // Earn coins faster over time
if (m.id === 2) coinsPerCycle = 4; // Earn coins even faster over time
}
});
}
// Smooth tick updates running at 10Hz
setInterval(() => {
if (dataPerSecond > 0) {
dataCount += (dataPerSecond / 10);
updateDisplay();
}
}, 100);
